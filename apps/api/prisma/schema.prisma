// Schema DEV tạm thời viết theo docs/03-co-so-du-lieu.md (track changes coi như đã chấp nhận), đúng dạng `prisma db pull` sẽ sinh.
// Khi nhóm DB gửi schema thật (MT-57): `db pull` rồi sửa các *.repository.ts

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum users_gioi_tinh {
  Nam
  Nu
  Khac // MT-59: tài liệu CSDL chỉ có Nam/Nu, Sheet có "other"
}

enum patients_nghe_nghiep {
  Cong_nhan            @map("Cong nhan")
  Nong_dan             @map("Nong dan")
  Hoc_sinh___Sinh_vien @map("Hoc sinh - Sinh vien")
  Can_bo_cong_chuc     @map("Can bo cong chuc")
  Khac
}

enum user_fcm_tokens_device_type {
  android
  ios
  web
}

model roles {
  role_id          Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(255)
  description      String?            @db.VarChar(255)
  parent_role_id   Int?
  created_at       DateTime           @default(now()) @db.DateTime(0)
  updated_at       DateTime           @default(now()) @updatedAt @db.DateTime(0)
  parent           roles?             @relation("roles_parent", fields: [parent_role_id], references: [role_id], onDelete: Restrict, onUpdate: Restrict)
  children         roles[]            @relation("roles_parent")
  staffs           staffs[]
  patients         patients[]
  role_permissions role_permissions[]
}

// Tài liệu CSDL không ghi unique cho name; dev đặt unique để chặn trùng (spec giai đoạn 2, mục 2).
model permissions {
  permission_id         Int                     @id @default(autoincrement())
  name                  String                  @unique @db.VarChar(255)
  description           String?                 @db.VarChar(255)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  updated_at            DateTime                @default(now()) @updatedAt @db.DateTime(0)
  role_permissions      role_permissions[]
  permissions_endpoints permissions_endpoints[]
}

// Tài liệu CSDL đã bỏ cột id (track change) → khoá chính ghép (MT-64).
model role_permissions {
  role_id       Int
  permission_id Int
  created_at    DateTime    @default(now()) @db.DateTime(0)
  updated_at    DateTime    @default(now()) @updatedAt @db.DateTime(0)
  role          roles       @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: Restrict)
  permission    permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: Restrict)

  @@id([role_id, permission_id])
  @@index([permission_id])
}

// Route của API, do lệnh đồng bộ (scripts/sync-endpoints.ts) ghi.
model api_endpoints {
  api_endpoints_id      Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(255)
  method                String                  @db.VarChar(255)
  path                  String                  @db.VarChar(255)
  description           String?                 @db.VarChar(255)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  updated_at            DateTime                @default(now()) @updatedAt @db.DateTime(0)
  permissions_endpoints permissions_endpoints[]

  @@unique([method, path])
}

model permissions_endpoints {
  permissions_endpoints_id Int           @id @default(autoincrement())
  permission_id            Int
  endpoint_id              Int
  created_at               DateTime      @default(now()) @db.DateTime(0)
  updated_at               DateTime      @default(now()) @updatedAt @db.DateTime(0)
  permission               permissions   @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: Restrict)
  endpoint                 api_endpoints @relation(fields: [endpoint_id], references: [api_endpoints_id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([permission_id, endpoint_id])
  @@index([endpoint_id])
}

model branches {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  address     String?       @db.VarChar(255)
  phone       String?       @db.VarChar(20)
  created_at  DateTime      @default(now()) @db.DateTime(0)
  updated_at  DateTime      @default(now()) @updatedAt @db.DateTime(0)
  departments departments[]
  staffs      staffs[]
}

model departments {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  branch_id   Int
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)
  branch      branches @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rooms       rooms[]
  staffs      staffs[]
}

model rooms {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(255)
  description   String?      @db.VarChar(255)
  department_id Int?
  created_at    DateTime     @default(now()) @db.DateTime(0)
  updated_at    DateTime     @default(now()) @updatedAt @db.DateTime(0)
  department    departments? @relation(fields: [department_id], references: [id], onDelete: SetNull, onUpdate: Restrict)
  staffs        staffs[]
}

model users {
  user_id             Int               @id @default(autoincrement())
  password_hash       String            @db.VarChar(255)
  ho_ten              String            @db.VarChar(255)
  so_dien_thoai       String            @unique @db.VarChar(20)
  gioi_tinh           users_gioi_tinh?
  reset_token         String?           @db.VarChar(255)
  reset_token_expires DateTime?         @db.DateTime(0)
  is_active           Boolean           @default(true)
  created_at          DateTime          @default(now()) @db.DateTime(0)
  updated_at          DateTime          @default(now()) @updatedAt @db.DateTime(0)
  staffs              staffs?
  patients            patients?
  user_fcm_tokens     user_fcm_tokens[]
  token_blacklist     token_blacklist[]
}

model staffs {
  user_id       Int          @id
  role_id       Int
  department_id Int?
  branch_id     Int?
  room_id       Int?
  user          users        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict)
  role          roles        @relation(fields: [role_id], references: [role_id], onDelete: Restrict, onUpdate: Restrict)
  department    departments? @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch        branches?    @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  room          rooms?       @relation(fields: [room_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model patients {
  user_id                          Int                   @id
  role_id                          Int
  ngay_sinh                        DateTime?             @db.Date
  nghe_nghiep                      patients_nghe_nghiep?
  dan_toc                          String?               @db.VarChar(100)
  dia_chi_so_nha_thon_pho          String?               @db.VarChar(100)
  dia_chi_xa_phuong                String?               @db.VarChar(100)
  dia_chi_tinh_tp                  String?               @db.VarChar(100)
  noi_lam_viec                     String?               @db.VarChar(100)
  bhyt_so_the                      String?               @db.VarChar(100)
  bhyt_gia_tri_den                 DateTime?             @db.Date
  nguoi_nha_ho_ten_dia_chi         String?               @db.VarChar(100)
  nguoi_nha_so_dien_thoai          String?               @db.VarChar(100)
  thoi_diem_kham_lan_dau           DateTime?             @db.DateTime(0)
  ngay_bat_dau_dieu_tri_ngoai_tru  DateTime?             @db.Date
  ngay_ket_thuc_dieu_tri_ngoai_tru DateTime?             @db.Date
  // Các cột tien_su_* của tài liệu CSDL thuộc MT-10, thêm khi có schema thật.
  created_at                       DateTime              @default(now()) @db.DateTime(0)
  updated_at                       DateTime              @default(now()) @updatedAt @db.DateTime(0)
  user                             users                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict)
  role                             roles                 @relation(fields: [role_id], references: [role_id], onDelete: Restrict, onUpdate: Restrict)
}

model user_fcm_tokens {
  id          Int                          @id @default(autoincrement())
  user_id     Int
  fcm_token   String                       @db.Text
  device_type user_fcm_tokens_device_type?
  created_at  DateTime                     @default(now()) @db.DateTime(0)
  updated_at  DateTime                     @default(now()) @updatedAt @db.DateTime(0)
  user        users                        @relation(fields: [user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict)

  @@index([user_id])
}

model token_blacklist {
  invalid_token_id Int      @id @default(autoincrement())
  jti              String   @unique @db.VarChar(64)
  user_id          Int
  expires_at       DateTime @db.DateTime(0)
  created_at       DateTime @default(now()) @db.DateTime(0)
  updated_at       DateTime @default(now()) @updatedAt @db.DateTime(0)
  user             users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict)
}

// ---- Mẫu phiếu khám động (spec giai đoạn 3, mục 2) ----
// MT-67: tài liệu CSDL ghi template_sections.template_id và parent_question_id kiểu int trong khi PK
// đã đổi sang varchar; CSDL dev dùng varchar cho cả hai để FK và chỉ mục khớp nhau.

enum template_sections_filled_by {
  patient
  doctor
  patdoc
}

enum questions_type_question {
  text
  number
  date
  radio
  checkbox
  image_upload
  group_questions
  mix_text_image
}

model templates {
  code_template     String              @id @db.VarChar(255)
  name              String              @db.VarChar(255)
  description       String?             @db.Text
  version           String              @default("1.0") @db.VarChar(50)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  updated_at        DateTime            @default(now()) @updatedAt @db.DateTime(0)
  template_sections template_sections[]
}

model template_sections {
  section_id  Int                          @id @default(autoincrement())
  template_id String                       @db.VarChar(255)
  title       String                       @db.VarChar(255)
  order       Int
  is_required Boolean                      @default(false)
  filled_by   template_sections_filled_by?
  created_at  DateTime                     @default(now()) @db.DateTime(0)
  updated_at  DateTime                     @default(now()) @updatedAt @db.DateTime(0)
  template    templates                    @relation(fields: [template_id], references: [code_template], onDelete: Cascade, onUpdate: Restrict)
  questions   questions[]
}

// parent_question_id chỉ có chỉ mục, không có FK (tài liệu CSDL): cây câu hỏi cha–con do API kiểm tra.
model questions {
  question_id        String                  @id @db.VarChar(50)
  section_id         Int
  question_text      String                  @db.Text
  type_question      questions_type_question
  placeholder        String?                 @db.VarChar(255)
  order              Int
  is_required        Boolean                 @default(false)
  parent_question_id String?                 @db.VarChar(50)
  show_if_answer     Json?
  condition_rules    Json?
  help_text          String?                 @db.Text
  allow_image        Boolean                 @default(false)
  created_at         DateTime                @default(now()) @db.DateTime(0)
  updated_at         DateTime                @default(now()) @updatedAt @db.DateTime(0)
  section            template_sections       @relation(fields: [section_id], references: [section_id], onDelete: Cascade, onUpdate: Restrict)
  question_options   question_options[]

  @@index([parent_question_id])
}

model question_options {
  id                   Int       @id @default(autoincrement())
  question_id          String    @db.VarChar(50)
  option_text          String    @db.VarChar(255)
  option_value         String    @db.VarChar(50)
  order                Int
  has_text_input       Boolean   @default(false)
  trigger_image_upload Boolean   @default(false)
  image_upload_label   String?   @db.VarChar(255)
  created_at           DateTime  @default(now()) @db.DateTime(0)
  updated_at           DateTime  @default(now()) @updatedAt @db.DateTime(0)
  question             questions @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: Restrict)
}
