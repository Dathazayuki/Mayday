# Cấu hình bộ demo (docker-compose.demo.yml). Sao chép thành .env.demo rồi chạy:
#   docker compose -f docker-compose.demo.yml --env-file .env.demo up -d --build
# Không có file này, bộ demo vẫn chạy bằng các giá trị mặc định dưới đây.
# Mọi giá trị ở đây CHỈ dành cho demo, không bảo vệ dữ liệu thật: không dùng cho môi trường thật.

# Cổng Web trên máy chủ (điện thoại cũng gọi API qua cổng này). Đổi khi cổng 8080 đã bận.
DEMO_WEB_PORT=8080

# Tài khoản và tên CSDL PostgreSQL trong container (không mở ra ngoài máy).
DEMO_POSTGRES_USER=drmayday
DEMO_POSTGRES_PASSWORD=drmayday-demo-only
DEMO_POSTGRES_DB=drmayday_demo

# Khoá ký token đăng nhập của API, tối thiểu 32 ký tự.
DEMO_JWT_SECRET=demo-only-jwt-secret-khong-dung-that-0123456789

# Admin do seed tạo: số điện thoại và mật khẩu đăng nhập.
DEMO_ADMIN_PHONE=0900000001
DEMO_ADMIN_PASSWORD=admin123

# Mật khẩu chung của các tài khoản mẫu (bác sĩ, điều dưỡng, bệnh nhân).
DEMO_SAMPLE_PASSWORD=demo1234
