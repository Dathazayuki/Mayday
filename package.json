{
  "name": "drmayday",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @drmayday/shared build && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @drmayday/shared build && pnpm -r typecheck",
    "dev:api": "pnpm --filter @drmayday/api start:dev",
    "dev:web": "pnpm --filter @drmayday/web dev",
    "dev:mobile": "pnpm --filter @drmayday/mobile start",
    "dev:shared": "pnpm --filter @drmayday/shared exec tsc -p tsconfig.build.json --watch",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
