# Sao chép thành .env ở thư mục gốc. KHÔNG commit file .env.

# ---- CSDL PostgreSQL dev (docker compose up -d postgres); schema nạp bằng db:reset ----
POSTGRES_PORT=5434
POSTGRES_DB=drmayday
POSTGRES_USER=drmayday
POSTGRES_PASSWORD=drmayday-dev-secret
DATABASE_URL=postgresql://drmayday:drmayday-dev-secret@127.0.0.1:5434/drmayday
# CSDL riêng cho test tích hợp; test:db nạp lại schema và xoá dữ liệu của CSDL này.
TEST_DATABASE_URL=postgresql://drmayday:drmayday-dev-secret@127.0.0.1:5434/drmayday_test
# Mật khẩu chung của các tài khoản mẫu do db:seed tạo (bác sĩ, điều dưỡng, bệnh nhân). Để trống: không tạo.
SEED_SAMPLE_PASSWORD=

# ---- API (apps/api) ----
# Môi trường của API: development | test | production. Bỏ trống hoặc production: tắt tính năng chỉ
# dành cho dev (ghi OTP khôi phục mật khẩu ra log, Swagger ở /api/v1/docs); giá trị khác → API không
# khởi động. production bắt buộc có DATABASE_URL.
# Không dùng NODE_ENV: file .env này dùng chung với Web, Vite đọc NODE_ENV từ đây và sẽ build Web ở
# chế độ development.
APP_ENV=development
PORT=3000
# DATABASE_URL ở khối CSDL phía trên. Để trống thì API vẫn chạy, /health báo db: not_configured (trừ
# APP_ENV=production: thiếu DATABASE_URL thì API không khởi động). Dạng postgresql://USER:PASSWORD@HOST:PORT/TEN_CSDL.
# db:reset, db:seed và test:db chỉ chạy với CSDL trên máy này (127.0.0.1, localhost, ::1).
# Origin trình duyệt được gọi API (CORS), cách nhau bởi dấu phẩy, dạng http(s)://host[:cổng], không có
# dấu / cuối. VD: CORS_ORIGINS=https://web.example.vn,https://admin.example.vn
# Để trống: development/test chỉ cho Web dev http://localhost:5173; production không cho origin nào.
# App mobile gọi API trực tiếp nên không cần khai báo ở đây.
CORS_ORIGINS=
# Tài khoản admin do seed tạo (pnpm --filter @drmayday/api db:seed) – chỉ dùng cho CSDL dev. Seed chỉ
# tạo khi số chưa có tài khoản (không ghi đè mật khẩu/họ tên đã đổi), từ chối khi APP_ENV không phải
# development/test hoặc khi số đã thuộc tài khoản vai trò khác.
SEED_ADMIN_PHONE=0900000001
SEED_ADMIN_PASSWORD=admin123
# Bắt buộc, tối thiểu 32 ký tự. Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Thời hạn access token, tính bằng giây
JWT_EXPIRES_IN=86400
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ACCESS_KEY=drmayday
MINIO_SECRET_KEY=drmayday-dev-secret
MINIO_BUCKET=drmayday

# ---- Web (apps/web) – Vite đọc file .env ở thư mục gốc ----
VITE_API_BASE_URL=http://localhost:3000

# ---- Mobile (apps/mobile) – chép dòng dưới vào apps/mobile/.env.
# Trên điện thoại thật dùng IP LAN của máy chạy API, ví dụ http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
