# Sao chép thành .env ở thư mục gốc. KHÔNG commit file .env.

# ---- CSDL MySQL dev (docker compose up -d mysql) – tạm thời, chờ MT-19, MT-57 ----
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=drmayday-root-dev
MYSQL_DATABASE=drmayday
MYSQL_USER=drmayday
MYSQL_PASSWORD=drmayday-dev-secret

# ---- API (apps/api) ----
# development | test | production. Bỏ trống hoặc production: tắt tính năng chỉ dành cho dev
# (VD ghi OTP khôi phục mật khẩu ra log); giá trị khác → API không khởi động.
NODE_ENV=development
PORT=3000
# Trỏ tới container mysql ở trên. Để trống thì API vẫn chạy, /health báo db: not_configured.
# Dạng: mysql://USER:PASSWORD@HOST:PORT/TEN_CSDL. MySQL 8.4 dùng caching_sha2_password: driver mariadb cần
# allowPublicKeyRetrieval=true để lấy khoá RSA khi server chưa cache mật khẩu (chỉ dùng cho dev/local).
DATABASE_URL=mysql://drmayday:drmayday-dev-secret@127.0.0.1:3307/drmayday?allowPublicKeyRetrieval=true
# CSDL riêng cho test tích hợp (pnpm --filter @drmayday/api test:db); test xoá dữ liệu của CSDL này.
TEST_DATABASE_URL=mysql://drmayday:drmayday-dev-secret@127.0.0.1:3307/drmayday_test?allowPublicKeyRetrieval=true
# Tài khoản admin do seed tạo (pnpm --filter @drmayday/api db:seed) – chỉ dùng cho CSDL dev.
SEED_ADMIN_PHONE=0900000001
SEED_ADMIN_PASSWORD=admin123
# Bắt buộc, tối thiểu 32 ký tự. Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Thời hạn access token, tính bằng giây
JWT_EXPIRES_IN=86400
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ACCESS_KEY=drmayday
MINIO_SECRET_KEY=drmayday-dev-secret
MINIO_BUCKET=drmayday

# ---- Web (apps/web) – Vite đọc file .env ở thư mục gốc ----
VITE_API_BASE_URL=http://localhost:3000

# ---- Mobile (apps/mobile) – chép dòng dưới vào apps/mobile/.env.
# Trên điện thoại thật dùng IP LAN của máy chạy API, ví dụ http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
